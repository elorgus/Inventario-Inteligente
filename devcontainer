{
  "name": "Apache & MySQL 9.7 Development Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts":,
  "portsAttributes": {
    "80": {
      "label": "Apache Web Server",
      "onAutoForward": "openBrowser"
    },
    "3306": {
      "label": "MySQL Database",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ]
    }
  },
  "remoteUser": "root"
}
